<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
</head>

<body class="bg-light" style="font-family: Arial, sans-serif; font-style: italic;">
  <div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="row w-100 justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h1 class="card-title text-center mb-4">Product Details</h1>

            <div class="text-start mb-4 px-4">
              <p class="mb-2 fs-5">
                <strong>Name:</strong>
                <%= product.name %>
              </p>

              <p class="mb-2 fs-5">
                <strong>Price:</strong> $<%= product.price %>
              </p>

              <p class="mb-2 fs-5">
                <strong>Category:</strong> <span class="badge bg-info">
                  <%= product.category %>
                </span>
              </p>
            </div>

            <div class="d-flex justify-content-center gap-2">
              <a href="/products" class="btn btn-outline-secondary btn-sm">Back to Products</a>
              <a href="/products/<%= product._id %>/edit" class="btn btn-warning btn-sm">Edit Product</a>

              <form action="/products/<%= product._id %>?_method=delete" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger btn-sm">Delete Product</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"></script>
</body>

</html>